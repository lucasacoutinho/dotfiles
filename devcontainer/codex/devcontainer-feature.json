{
  "id": "codex",
  "version": "1.6.0",
  "name": "OpenAI Codex CLI",
  "description": "Installs OpenAI Codex CLI and mounts only host authentication into the devcontainer",
  "documentationURL": "https://github.com/lucasacoutinho/dotfiles/tree/main/devcontainer/codex",
  "keywords": [
    "codex",
    "openai",
    "ai",
    "cli",
    "credentials"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of Codex CLI to install"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.codex/auth.json",
      "target": "/mnt/host-codex-auth.json",
      "type": "bind"
    }
  ],
  "installsAfter": [
    "ghcr.io/devcontainers/features/node"
  ],
  "postStartCommand": "/usr/local/bin/codex-setup"
}
