{
  "id": "gemini-cli",
  "version": "1.6.0",
  "name": "Google Gemini CLI",
  "description": "Installs Google Gemini CLI and mounts only host authentication into the devcontainer",
  "documentationURL": "https://github.com/lucasacoutinho/dotfiles/tree/main/devcontainer/gemini-cli",
  "keywords": [
    "gemini",
    "google",
    "ai",
    "cli",
    "credentials"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of Gemini CLI to install"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.gemini/oauth_creds.json",
      "target": "/mnt/host-gemini-oauth-creds.json",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.gemini/google_accounts.json",
      "target": "/mnt/host-gemini-google-accounts.json",
      "type": "bind"
    }
  ],
  "installsAfter": [
    "ghcr.io/devcontainers/features/node"
  ],
  "postStartCommand": "/usr/local/bin/gemini-setup"
}
