{
  "id": "claude-code",
  "version": "1.8.0",
  "name": "Claude Code CLI",
  "description": "Installs Claude Code CLI and mounts only host authentication into the devcontainer",
  "documentationURL": "https://github.com/lucasacoutinho/dotfiles/tree/main/devcontainer/claude-code",
  "keywords": [
    "claude",
    "anthropic",
    "ai",
    "cli",
    "credentials"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of Claude Code CLI to install (e.g., 'latest', '1.0.3')"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.claude/.credentials.json",
      "target": "/mnt/host-claude-credentials.json",
      "type": "bind"
    }
  ],
  "installsAfter": [
    "ghcr.io/devcontainers/features/node"
  ],
  "postStartCommand": "/usr/local/bin/claude-code-setup"
}
