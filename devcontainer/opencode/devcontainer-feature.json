{
  "id": "opencode",
  "version": "1.2.0",
  "name": "OpenCode CLI",
  "description": "Installs OpenCode CLI and mounts only host authentication into the devcontainer",
  "documentationURL": "https://github.com/lucasacoutinho/dotfiles/tree/main/devcontainer/opencode",
  "keywords": [
    "opencode",
    "anomaly",
    "ai",
    "cli",
    "credentials"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of OpenCode CLI to install (e.g., 'latest', '1.0.0')"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.local/share/opencode/auth.json",
      "target": "/mnt/host-opencode-auth.json",
      "type": "bind"
    }
  ],
  "installsAfter": [
    "ghcr.io/devcontainers/features/node"
  ],
  "postStartCommand": "/usr/local/bin/opencode-setup"
}
